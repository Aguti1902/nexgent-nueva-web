{
  "framework": null,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/reunion-consultores",
      "destination": "https://calendly.com/nexgent-demo/30min",
      "permanent": false
    },
    {
      "source": "/reunion",
      "destination": "https://calendly.com/nexgent-demo/30min",
      "permanent": false
    },
    {
      "source": "/contacto",
      "destination": "/#contacto",
      "permanent": true
    },
    {
      "source": "/demo",
      "destination": "/#contacto",
      "permanent": true
    },
    {
      "source": "/agendar-demo",
      "destination": "/#contacto",
      "permanent": true
    },
    {
      "source": "/soluciones/:slug*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/sobre-nosotros",
      "destination": "/#nosotros",
      "permanent": true
    },
    {
      "source": "/casos-de-exito/:slug*",
      "destination": "/blog/categoria/casos-de-exito",
      "permanent": true
    },
    {
      "source": "/precios",
      "destination": "/#contacto",
      "permanent": true
    },
    {
      "source": "/privacidad",
      "destination": "/legal#privacidad",
      "permanent": true
    },
    {
      "source": "/aviso-legal",
      "destination": "/legal#aviso-legal",
      "permanent": true
    },
    {
      "source": "/cookies",
      "destination": "/legal#cookies",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/video/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/consultores/Nexgent-IA-consultores.pdf",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
